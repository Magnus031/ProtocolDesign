digraph "Graphical Class Hierarchy"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  rankdir="LR";
  Node0 [label="_time_def",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$class__time__def.html",tooltip=" "];
  Node0 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node1 [label="time_span",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classtime__span.html",tooltip=" "];
  Node0 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node2 [label="time_value",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classtime__value.html",tooltip=" "];
}
