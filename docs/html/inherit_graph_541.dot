  Node0 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node1 [label="SObjArrayWithLock\<\l TObj \>",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$class_s_obj_array_with_lock.html",tooltip=" "];
}
