digraph "_unique_com_header"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="_unique_com_header",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" hd" ,fontname="Helvetica"];
  Node2 [label="sa_handle",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classsa__handle.html",tooltip="A class for shared assembly handle."];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" block" ,fontname="Helvetica"];
  Node3 [label="unique_com_block",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structunique__com__block.html",tooltip=" "];
  Node4 -> Node3 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node4 [label="unique_com_block_base",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structunique__com__block__base.html",tooltip=" "];
  Node5 -> Node4 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node5 [label="unique_block_base",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structunique__block__base.html",tooltip=" "];
  Node6 -> Node5 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" m_pMgr" ,fontname="Helvetica"];
  Node6 [label="i_memory_manager",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classi__memory__manager.html",tooltip=" "];
}
