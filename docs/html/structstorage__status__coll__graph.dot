digraph "storage_status"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="storage_status",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="< Create new file only"];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" tmAccess\ntmCreate\ntmModify" ,fontname="Helvetica"];
  Node2 [label="time_value",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classtime__value.html",tooltip=" "];
  Node3 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node3 [label="_time_def",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$class__time__def.html",tooltip=" "];
}
